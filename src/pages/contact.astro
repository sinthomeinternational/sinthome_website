---
import H1 from "../components/ui/H1.astro";
import PageLayout from "../layouts/PageLayout.astro";
import ContactMethods from "../components/contact/ContactMethods";
import { SITE_CONFIG } from "../config/site";
import { getThemeFromURL } from "../lib/utils";
import { getTranslations, getLanguageFromURL } from "../lib/translations";

const theme = getThemeFromURL(Astro.url);
const lang = getLanguageFromURL(Astro.url);
const t = getTranslations(lang);
const pageContent = t.pages.contact;
---

<PageLayout title={`${pageContent.title} - Sinthome`} useInfoLayout={true} theme={theme}>
     <div class="min-h-dvh py-12">
          <!-- Header Section -->
          <div class="text-center mb-16">
               <H1 className="text-red-600 mb-6">{pageContent.hero.title}</H1>
               <p class="text-xl max-w-2xl mx-auto" style="color: var(--theme-text-secondary);">
                    {pageContent.hero.subtitle}
               </p>
          </div>

          <!-- Contact Methods Component -->
          <ContactMethods client:visible lang={lang} />

          <!-- Connect & Collaborate Section -->
          <div class="mt-20 pt-12 border-t" style="border-color: var(--theme-border);">
               <div class="max-w-4xl mx-auto text-center">
                    <h3 class="text-xl font-semibold mb-4" style="color: var(--theme-text-primary);">{pageContent.collaborate.title}</h3>
                    <p class="mb-8" style="color: var(--theme-text-muted);">
                         {pageContent.collaborate.description}
                    </p>

                    <!-- Quick Links -->
                    <div class="flex flex-col sm:flex-row justify-center gap-6">
                         <a
                              href="/what-we-do"
                              class="inline-flex items-center text-red-400 hover:text-red-300 transition-colors"
                         >
                              <span class="mr-2">→</span>
                              {pageContent.collaborate.links.projects}
                         </a>
                         <a
                              href="/events"
                              class="inline-flex items-center text-red-400 hover:text-red-300 transition-colors"
                         >
                              <span class="mr-2">→</span>
                              {pageContent.collaborate.links.events}
                         </a>
                         <a
                              href="/donate"
                              class="inline-flex items-center text-red-400 hover:text-red-300 transition-colors"
                         >
                              <span class="mr-2">→</span>
                              {pageContent.collaborate.links.support}
                         </a>
                    </div>
               </div>
          </div>

          <!-- Footer Message -->
          <div class="mt-20 text-center">
               <div class="inline-block p-6 bg-gradient-to-r from-red-600/10 to-red-700/10 rounded-2xl border border-red-600/20">
                    <p class="text-lg font-medium mb-2" style="color: var(--theme-text-secondary);">
                         {pageContent.footer.title}
                    </p>
                    <p class="text-sm" style="color: var(--theme-text-muted);">
                         {pageContent.footer.subtitle}
                    </p>
               </div>
          </div>
     </div>
</PageLayout>